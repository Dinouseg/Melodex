config.json
cookies.txt
*.log

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# PyInstaller spec is generated by build.py
*.spec

# Local tooling caches
.serena/
.claude/
